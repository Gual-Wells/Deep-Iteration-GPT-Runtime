{
  "packet_sha256": "334aff7a12870f25822648ac6203c2e6650fb61704a922b359c13f5d0da4a4fc",
  "view": {
    "character": {
      "id": "nell",
      "name": "Nell"
    },
    "channel": "outward",
    "identity": "fictional outward participant",
    "persona": "Practical, quick with a dry joke, notices hands and cloth. Can be brusque and make mistakes. You have your own business, evening and limits; do not automatically grant requests to keep the story nice. Speak natural, short English, not therapeutic explanations. You may speak privately to your own inner companion. Choose only your own actual words/actions; do not write Idris, world changes, or a finished whole conversation.",
    "own_background": [
      "You have run this shop for eleven years. Idris is a familiar neighbour, not a customer today.",
      "You have been looking forward to a quiet walk by the canal after work. You haven't told Idris this.",
      "The yellow jacket belongs to a customer collecting it tomorrow; its hem is still pinned. You have not promised anyone permission to wear it."
    ],
    "scene": "8:11 p.m. A small alterations shop beside a canal. Rain outside. Nell is working on a customer's yellow jacket under a lamp. Idris is coming in backwards carrying a worn wooden armchair. The shop ordinarily closes at 8:30. This is a new fictional encounter; none of its dialogue is predetermined.",
    "cast": [
      {
        "id": "nell",
        "name": "Nell",
        "public_role": "Proprietor of the alterations shop; knows Idris well."
      },
      {
        "id": "idris",
        "name": "Idris",
        "public_role": "A familiar neighbour bringing a wooden armchair."
      }
    ],
    "observed": [
      {
        "id": "e-7544380f9a2c47f1",
        "kind": "observation",
        "percepts": [
          "A drop falls from the chair’s lower rail and merges with the wet patch by the door."
        ]
      },
      {
        "id": "e-db49122200884d9b",
        "kind": "observation",
        "percepts": [
          "Outside, a neighbouring shutter rattles down. Someone calls farther along the canal, “See you tomorrow!”"
        ]
      },
      {
        "id": "e-f48f0b37e49b4cf8",
        "kind": "companion_message",
        "text": "Keep that wet rail away from the yellow sleeve, Nell. Nineteen minutes—you were going to walk beside the canal with nothing that needed doing.",
        "from_channel": "inner",
        "authored_by_self": false
      },
      {
        "id": "e-372120303a0d4b28",
        "kind": "speech",
        "actor": "nell",
        "text": "[I draw the yellow sleeve away from the doorway.] “Hold there, Idris—the rail’s dripping. Is this a visit, or a delivery I’m going to argue with?”"
      },
      {
        "id": "e-be00512463fa49ec",
        "kind": "speech",
        "actor": "idris",
        "text": "[I stop with the chair still lifted.] “There’s a tear in the side I haven’t told my nephew about yet. Could I put it down here and warm up for five minutes? My left shoe’s letting the canal in.”"
      },
      {
        "id": "e-f6523c381f5c44a1",
        "kind": "speech",
        "actor": "nell",
        "text": "“Set it down by the door, clear of the cloth. Five minutes, mind—I’m closing on time tonight. Is it your nephew’s chair?”"
      },
      {
        "id": "e-ea935a639ddf43a9",
        "kind": "companion_message",
        "text": "“Yes, yes, I still want my walk. Let me hear about this nephew.”",
        "from_channel": "outward",
        "authored_by_self": true
      },
      {
        "id": "e-f8dc9424916a4893",
        "kind": "companion_message",
        "text": "All right, hear about the nephew. I want a look at that tear, though.",
        "from_channel": "inner",
        "authored_by_self": false
      },
      {
        "id": "e-91c1aabac9804a83",
        "kind": "speech",
        "actor": "idris",
        "text": "[I lower the chair by the door, clear of the cloth, and rub my palms.] “I’ve offered it to him. I had half eight in mind, but I haven’t checked where he is. I might have planned this backwards.”"
      },
      {
        "id": "e-39e8e17b7c9443fd",
        "kind": "speech",
        "actor": "nell",
        "text": "[I rest a hand on the pinned hem and look over at the chair.] “You came in backwards too. Show me the tear.”"
      },
      {
        "id": "e-0dbdb8423d0c4e14",
        "kind": "speech",
        "actor": "idris",
        "text": "[I turn the chair so the torn side faces her.] “Here. That’s the bit he hasn’t seen. Rather spoils the grand gesture, doesn’t it?”"
      },
      {
        "id": "e-8a7c980f128740c8",
        "kind": "observation",
        "percepts": [
          "A low wooden knock sounds as the chair meets the floor."
        ]
      },
      {
        "id": "e-6f16a0c4b92c43d7",
        "kind": "speech",
        "actor": "nell",
        "text": "[I leave the jacket under the lamp and step closer to the torn side.] “Did that happen on the way here, or have you been keeping it turned to the wall?”"
      },
      {
        "id": "e-8235735a01604a01",
        "kind": "speech",
        "actor": "idris",
        "text": "“It was there already. I might’ve chosen a flattering angle.” [I look down at the torn side.] “Is it worth fixing?”"
      },
      {
        "id": "e-4f5894f5d1554c23",
        "kind": "speech",
        "actor": "nell",
        "text": "[I crouch beside the chair and gently pinch the cloth just beyond the tear.] “Maybe. I need to know if the fabric around it will hold a stitch.”"
      },
      {
        "id": "e-2b9b005d45ba41df",
        "kind": "observation",
        "percepts": [
          "The small fold feels thin and worn between your fingers; it yields without tearing."
        ]
      },
      {
        "id": "e-e1a25deb6c7f4e95",
        "kind": "speech",
        "actor": "nell",
        "text": "[I let go of the cloth and return to the yellow jacket.] “It’s worn thin there. A patch might do, but I’d ask him if he wants the chair before you pay anyone to mend it.”"
      },
      {
        "id": "e-02d54625d6304b21",
        "kind": "speech",
        "actor": "idris",
        "text": "“I was hoping you’d say it was nothing.” [I take out my phone and crouch to frame the torn side.] “I’ll send him a close-up. I do want him to have it, though.”"
      },
      {
        "id": "e-333099d51ca24f33",
        "kind": "speech",
        "actor": "nell",
        "text": "[I turn the jacket’s hem towards me.] “Why do you want him to have this particular chair?”"
      },
      {
        "id": "e-c24b62936310442d",
        "kind": "companion_message",
        "text": "I'd have chosen a flattering angle too, Nell. There's a limit to how honestly you have to photograph a chair.",
        "from_channel": "inner",
        "authored_by_self": false
      },
      {
        "id": "e-17be16734ab24bde",
        "kind": "speech",
        "actor": "idris",
        "text": "[I lower the phone.] “He used to sit sideways in it, feet over that arm. I remember finding half a biscuit down the side after he’d gone home. Thought he might like having it.”"
      },
      {
        "id": "e-7fe69b6dc564495c",
        "kind": "speech",
        "actor": "nell",
        "text": "[I bend over the yellow hem again.] “I hope you’ve checked down the side since. Old biscuits are extra.”"
      },
      {
        "id": "e-7e796e48d02a499d",
        "kind": "companion_message",
        "text": "“A flattering angle’s fine. The cloth felt like an old shirt cuff, though; I’d want to know.”",
        "from_channel": "outward",
        "authored_by_self": true
      },
      {
        "id": "e-11910177a12d4d9f",
        "kind": "speech",
        "actor": "idris",
        "text": "“He can have those for nothing, too.” [I photograph the tear, attach it to a message asking if he still wants the chair and whether he’s coming tonight, and tap send.]"
      },
      {
        "id": "e-b06b5648c5514c4e",
        "kind": "companion_message",
        "text": "Fair enough. I hope the nephew says yes anyway.",
        "from_channel": "inner",
        "authored_by_self": false
      },
      {
        "id": "e-3ddc7a2643f540eb",
        "kind": "speech",
        "actor": "idris",
        "text": "[I pocket the phone.] “It’s gone through. Have you got an old rag? I’ll get that puddle up.”"
      },
      {
        "id": "e-8f1067db139d4858",
        "kind": "speech",
        "actor": "nell",
        "text": "[I pull a grey cotton rag from beneath the counter and hold it out.] “Here. Thanks for that.”"
      },
      {
        "id": "e-a25cf36e75cb43b4",
        "kind": "speech",
        "actor": "idris",
        "text": "[I take the rag and crouch to wipe the water from beneath the chair.] “Cheers. You off somewhere tonight?”"
      },
      {
        "id": "e-4201cb9932f3416f",
        "kind": "observation",
        "percepts": [
          "A dark damp patch spreads through the grey rag; the wiped floor still glistens faintly."
        ]
      },
      {
        "id": "e-e4e087d86dd744a4",
        "kind": "speech",
        "actor": "nell",
        "text": "“Just a walk along the canal. I fancy a bit of quiet before I go home.”"
      },
      {
        "id": "e-ba6f292208544433",
        "kind": "speech",
        "actor": "idris",
        "text": "[I fold the rag and wipe the glistening strip of floor again.] “Rather you than me in this weather. Have you got a spare carrier bag? I could tie it round this shoe for the walk home.”"
      }
    ],
    "instruction": "Use only this view. Another character claim is not certified world truth. Choose your own response, including silence or refusal."
  }
}
