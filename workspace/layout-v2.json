{
  "schema_version": 2,
  "required_genesis_files": [
    "authority.json",
    "invocation.json",
    "startup.json",
    "time/clock.journal.ndjson",
    "state/artifact-index.json",
    "state/run-phase.json"
  ],
  "state_directories": [
    "time",
    "sources",
    "dictator",
    "viewpoints",
    "logs",
    "evidence",
    "final",
    "state"
  ],
  "artifact_schemas": {
    "authority.json": "schemas/protocol-authority.schema.json",
    "invocation.json": "schemas/invocation-surface.schema.json",
    "startup.json": "schemas/task-startup.schema.json",
    "protocol-load.json": "schemas/executing-protocol-load.schema.json",
    "parameter-resolution.json": "schemas/parameter-resolution.schema.json",
    "preflight-receipt.json": "schemas/preflight-receipt.schema.json",
    "capability-negotiation.json": "schemas/capability-negotiation.schema.json",
    "U0.json": "schemas/u0-receipt.schema.json",
    "contract.json": "schemas/effective-contract.schema.json",
    "time/clock.journal.ndjson": "schemas/clock-journal-event.schema.json",
    "time/source-activity.ndjson": "schemas/source-activity-event.schema.json",
    "time/d-activity.ndjson": "schemas/exclusive-activity.schema.json",
    "time/v-activity.ndjson": "schemas/exclusive-activity.schema.json",
    "events.ndjson": "schemas/evolution-event.schema.json",
    "state/run-phase.json": "schemas/run-phase.schema.json",
    "state/run-phase-r*.json": "schemas/run-phase.schema.json",
    "state/artifact-index.json": "schemas/artifact-index.schema.json",
    "state/strategy-latest.json": "schemas/strategy-state.schema.json",
    "state/strategy-r*.json": "schemas/strategy-state.schema.json",
    "state/candidate-latest.json": "schemas/candidate-snapshot.schema.json",
    "state/candidate-r*.json": "schemas/candidate-snapshot.schema.json",
    "state/candidate-payloads/*.bin": "binary",
    "state/est-*-latest.json": "schemas/est-snapshot.schema.json",
    "state/est-*-r*.json": "schemas/est-snapshot.schema.json",
    "state/run-brief.json": "schemas/run-brief.schema.json",
    "sources/*/state.json": "schemas/source-workspace.schema.json",
    "sources/*/state-r*.json": "schemas/source-workspace.schema.json",
    "dictator/isolation/*.json": "schemas/isolation-receipt.schema.json",
    "dictator/packets/*.json": "schemas/isolation-packet.schema.json",
    "dictator/*.json": "schemas/d-intervention.schema.json",
    "viewpoints/*/ledger-r*.json": "schemas/viewpoint-ledger.schema.json",
    "logs/*.ndjson": "schemas/audit-log-event.schema.json",
    "evidence/index.json": "schemas/evidence-index.schema.json",
    "state/gaps/*-r*.json": "schemas/completion-gap.schema.json",
    "state/completion.json": "schemas/completion-state.schema.json",
    "state/terminal-seal.json": "schemas/terminal-seal.schema.json",
    "final/delivery.bin": "binary",
    "final/run-summary.json": "schemas/run-summary.schema.json",
    "final/stable-proof.json": "schemas/stable-proof.schema.json",
    "final/delivery-envelope.json": "schemas/delivery-envelope.schema.json",
    "final/incomplete-summary.json": "schemas/incomplete-summary.schema.json"
  }
}
