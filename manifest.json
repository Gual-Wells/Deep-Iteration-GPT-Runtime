{
  "name": "Deep Iteration GPT Runtime",
  "short_name": "DIGR",
  "version": "3.0.0",
  "protocol": "digr-v3.0",
  "language": "zh-CN",
  "philosophy": {
    "primary_object": "high_quality_task_result_under_faithful_U0",
    "result_sovereignty": true,
    "native_chatgpt_control": true,
    "protocol_is_minimum_guarantees_not_algorithm": true,
    "lightweight_observability": true
  },
  "trigger": {
    "activation_scope": "current_user_turn_only",
    "non_sticky": true,
    "explicit_prefix_required": true,
    "plain_examples": [
      "深度迭代：<任务>",
      "深度迭代:<任务>"
    ],
    "parameterized_example": "深度迭代（N，T，R，B，S（n，t，r，b））：<任务>",
    "help_command": "深度迭代/help",
    "semantic_interpreter": "ChatGPT",
    "parser_is_not_authority": true
  },
  "parameters": {
    "N": "minimum_effective_main_evolution_cycles",
    "T": "target_actual_closed_loop_runtime",
    "R": "minimum_whole_process_result_reentry_evolution_cycles",
    "B": "soft_or_hard_T_policy",
    "S": {
      "meaning": "repeatable_external_research_evolution_template",
      "n": "minimum_effective_evolution_cycles_per_S_instance",
      "t": "aggregate_actual_source_activity_time_target_across_all_S_instances",
      "r": "minimum_result_reentry_evolution_cycles_per_S_instance",
      "b": "source_soft_or_hard_policy_inherited_by_each_S_instance"
    }
  },
  "core": [
    "core/00_RESULT_SOVEREIGNTY.md",
    "core/10_INVOCATION_AND_U0.md",
    "core/20_MINIMUM_GUARANTEES.md",
    "core/30_EVOLUTION_STATE_MEMORY.md",
    "core/40_NATIVE_EVOLUTION.md",
    "core/50_SOURCE_EVOLUTION.md",
    "core/60_TRUSTED_TIME_CONTROL.md",
    "core/70_REENTRY_BREAKTHROUGH.md",
    "core/80_STOP_AND_PROOF.md"
  ],
  "entrypoint": "entry/DEEP_ITERATION_ENTRY.md",
  "help": "entry/HELP.md",
  "local_fallback_core": "bootstrap/LOCAL_FALLBACK_CORE.md",
  "deterministic_helpers": [
    "runtime/clock_probe.py",
    "runtime/duration.py",
    "runtime/protocol_pin.py",
    "runtime/state_checks.py"
  ],
  "policies": {
    "preserve_original_task": true,
    "preserve_native_capabilities": true,
    "no_algorithmic_tree_controller": true,
    "est_is_working_state_memory_only": true,
    "N_R_n_r_are_minima_not_caps": true,
    "S_minimums_never_disable_future_research": true,
    "hard_time_requires_trusted_clock": true,
    "hard_time_fail_closed_when_unverifiable": true,
    "no_idle_padding": true,
    "no_repetition_padding": true,
    "R_r_use_whole_process_default_challenge": true,
    "R_r_include_anti_bureaucracy_guard": true,
    "do_not_weaken_real_safety_or_permissions": true,
    "minimal_default_proof": true,
    "do_not_reveal_hidden_reasoning": true,
    "pin_remote_protocol_to_one_commit_when_possible": true
  }
}
