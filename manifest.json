{
  "name": "Deep Iteration GPT Runtime",
  "short_name": "DIGR",
  "version": "5.0.0-alpha.10",
  "protocol": "digr-v5.0",
  "language": "zh-CN",
  "philosophy": {
    "primary_object": "high_quality_task_result_under_faithful_U0",
    "result_sovereignty": true,
    "task_commitment": true,
    "constrain_stopping_not_intelligence": true,
    "native_model_control": true,
    "protocol_is_minimum_guarantees_not_algorithm": true,
    "lightweight_observability": true,
    "native_intelligence_is_only_task_decision_plane": true,
    "deterministic_support_is_exoskeleton_not_orchestrator": true,
    "externalize_memory_timing_evidence_and_audit": true
  },
  "trigger": {
    "activation_scope": "current_user_turn_only",
    "non_sticky": true,
    "explicit_prefix_required_at_message_head": true,
    "task_separator_colon_required": true,
    "aliases": [
      "DIGR",
      "深度迭代"
    ],
    "help_commands": [
      "DIGR/help",
      "深度迭代/help"
    ],
    "semantic_interpreter": "ChatGPT_or_host_LLM",
    "parser_is_not_authority": true,
    "auto_mode_exists": false
  },
  "defaults": {
    "B": 0,
    "b": 0,
    "semantic_completion": [
      "N",
      "T",
      "R",
      "n",
      "t",
      "r"
    ],
    "D_s": 0,
    "explicit_empty_D": "semantic_completion"
  },
  "parameters": {
    "N": "minimum_effective_main_evolution_cycles",
    "T": "formal_active_task_time_target",
    "R": "minimum_whole_process_result_reentry_cycles",
    "B": "soft_or_hard_T_policy_0_or_1",
    "S": {
      "n": "minimum_effective_evolution_cycles_per_actual_S",
      "t": "aggregate_formal_active_source_time_target",
      "r": "minimum_result_reentry_cycles_per_actual_S",
      "b": "soft_or_hard_t_policy_0_or_1"
    },
    "D": {
      "s": "minimum_completed_disruptive_gambit_interventions; zero_means_no_minimum_not_disabled"
    }
  },
  "time_states": {
    "MAIN": {
      "T": true,
      "t": false
    },
    "SOURCE": {
      "T": true,
      "t": true
    },
    "D_EXCLUSIVE": {
      "T": true,
      "t": false
    },
    "META": {
      "T": false,
      "t": false
    },
    "IDLE": {
      "T": false,
      "t": false
    }
  },
  "core": [
    "core/00_RESULT_SOVEREIGNTY.md",
    "core/10_INVOCATION_AND_U0.md",
    "core/20_EFFECTIVE_CONTRACT.md",
    "core/25_RUN_SESSION_AND_EXTERNAL_MEMORY.md",
    "core/40_NATIVE_EVOLUTION.md",
    "core/60_FORMAL_ACTIVE_TIME.md",
    "core/80_STOP_AND_PROOF.md"
  ],
  "entrypoint": "entry/DEEP_ITERATION_ENTRY.md",
  "help": "entry/HELP.md",
  "deterministic_helpers": [
    "runtime/routing.py",
    "runtime/repository_transport.py",
    "runtime/execution_protocol.py",
    "runtime/runtime_package.py",
    "runtime/protocol_authority.py",
    "runtime/invocation_surface.py",
    "runtime/parameter_resolution.py",
    "runtime/clock_probe.py",
    "runtime/task_startup.py",
    "runtime/workspace.py",
    "runtime/clock_journal.py",
    "runtime/run_lifecycle.py",
    "runtime/run_session.py",
    "runtime/run_recovery.py",
    "runtime/run_brief.py",
    "runtime/effective_contract.py",
    "runtime/interval_ledger.py",
    "runtime/evolution_events.py",
    "runtime/strategy_store.py",
    "runtime/candidate_store.py",
    "runtime/est_store.py",
    "runtime/evidence_index.py",
    "runtime/source_workspace.py",
    "runtime/d_intervention.py",
    "runtime/completion_state.py",
    "runtime/actuals.py",
    "runtime/isolation_checks.py",
    "runtime/state_checks.py",
    "runtime/stop_checks.py",
    "runtime/proof.py",
    "runtime/protocol_pin.py",
    "runtime/duration.py",
    "runtime/validation.py"
  ],
  "policies": {
    "preserve_original_task": true,
    "protocol_authority_freeze": true,
    "P_target_cannot_rebind_current_run": true,
    "no_substantive_task_work_before_live_run": true,
    "implementation_identity_precedes_semantic_equivalence": true,
    "single_runtime_package_attestation_replaces_per_helper_verification": true,
    "runtime_package_verifier_binds_bundle_members_to_git_tree": true,
    "runtime_package_attestation_emits_protocol_load": true,
    "no_mandatory_repository_transport_after_genesis": true,
    "semantic_default_time_is_soft_unless_explicit_hard": true,
    "source_disposition_is_semantic_necessity_decision": true,
    "source_waiver_disables_all_source_mechanical_gates": true,
    "omitted_D_defaults_zero": true,
    "explicit_empty_D_may_semantically_complete": true,
    "compact_D_completion_preferred": true,
    "compact_D_requires_distinct_execution_evidence": true,
    "ordinary_resume_uses_fast_path": true,
    "full_workspace_audit_is_anomaly_fallback_or_explicit": true,
    "derived_latest_cache_is_unindexed": true,
    "artifact_index_hot_path_is_append_only_delta": true,
    "artifact_index_full_compaction_is_coarse_or_final": true,
    "state_transition_does_not_force_global_checkpoint": true,
    "soft_timing_does_not_force_work_lease": true,
    "clock_epoch_rollover_preserves_run": true,
    "clock_continuity_failure_forfeits_gap_not_run": true,
    "hard_time_accumulates_verified_intervals_across_epochs": true,
    "reentry_cannot_move_backward_to_superseded_result": true,
    "D_result_must_preserve_isolation_until_reintegration": true,
    "finalization_admission_precedes_ledger_finish": true,
    "FINISHED_requires_delivery_ready": true,
    "final_delivery_runs_one_artifact_integrity_scan": true,
    "no_padding": true,
    "do_not_reveal_hidden_reasoning": true,
    "journal_reindex_is_batched": true,
    "reliability_cost_must_not_scale_by_repeated_full_history_scans": true
  },
  "bootstrap_entry": "bootstrap/BOOTSTRAP.md",
  "bootstrap_index": "bootstrap/INDEX.md",
  "startup_slice": [
    "bootstrap/INDEX.md",
    "bootstrap/BOOTSTRAP.md",
    "entry/STARTUP.md"
  ],
  "routing_schema": 4,
  "routing": {
    "candidate_route_keys": [
      "DIGR",
      "深度迭代"
    ],
    "candidate_match": "lstrip_prefix; DIGR_exact_uppercase; remainder_unvalidated",
    "repository_full_name": "Gual-Wells/Deep-Iteration-GPT-Runtime",
    "repository_url": "https://github.com/Gual-Wells/Deep-Iteration-GPT-Runtime",
    "requested_ref": "stable",
    "ref_api_url": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/git/ref/heads/stable",
    "manifest_path": "manifest.json",
    "version_path": "VERSION",
    "content_api_template": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/contents/{PATH}?ref={SHA}",
    "branch_api_url": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/branches/stable",
    "pinned_raw_template": "https://raw.githubusercontent.com/Gual-Wells/Deep-Iteration-GPT-Runtime/{SHA}/{PATH}",
    "content_raw_media_type": "application/vnd.github.raw+json",
    "mutable_ref_policy": "connector_branch_head_or_direct_rest_branch_ref_consensus; search_index_forbidden; attempt_required_before_failure"
  },
  "run_session_schema": 7,
  "workspace_schema": 2,
  "clock_journal_schema": 1,
  "event_receipt_schema": 2,
  "release": {
    "channel": "alpha",
    "baseline_target": "5.0.0",
    "status": "liveness-contraction baseline intended to converge toward DIGR 5.0 final",
    "compatibility_intent": "Preserve P_run/U0/contract authority, current-result R/r, explicit hard timing, D reintegration and durable FINISH while making normal execution coarse-grained and finishable.",
    "alpha10_focus": [
      "single package+protocol startup attestation",
      "seven-core semantic authority",
      "soft default timing",
      "source by necessity",
      "omitted D zero / compact D",
      "fast resume / anomaly-only full audit",
      "unindexed derived caches",
      "append-only artifact-index delta hot path",
      "one final artifact-integrity settlement"
    ],
    "allowed_pre_final_evolution": [
      "bug fixes",
      "documentation",
      "regression guards",
      "measured liveness work preserving Alpha 10 invariants"
    ]
  },
  "workspace_spec": "workspace/layout-v2.json",
  "invocation_surface_schema": 2,
  "parameter_resolution_schema": 2,
  "repository_transport_schema": 3,
  "execution_bundle_schema": 1,
  "execution_protocol_load_schema": 1,
  "execution_bundle": {
    "path": "bundle/EXECUTION_PROTOCOL.json",
    "schema": 1,
    "members": [
      "entry/DEEP_ITERATION_ENTRY.md",
      "core/00_RESULT_SOVEREIGNTY.md",
      "core/10_INVOCATION_AND_U0.md",
      "core/20_EFFECTIVE_CONTRACT.md",
      "core/25_RUN_SESSION_AND_EXTERNAL_MEMORY.md",
      "core/40_NATIVE_EVOLUTION.md",
      "core/60_FORMAL_ACTIVE_TIME.md",
      "core/80_STOP_AND_PROOF.md"
    ]
  },
  "runtime_distribution_schema": 3,
  "runtime_distribution": {
    "schema": 3,
    "mode": "native_bridge_or_exact_commit_release_or_actions_artifact",
    "workflow_path": ".github/workflows/digr-runtime-artifact.yml",
    "artifact_name_template": "digr-runtime-{SHA}",
    "archive_filename_template": "DIGR-RUNTIME-{SHA}.zip",
    "member_source": "deterministic_helpers_plus_execution_bundle",
    "runtime_index_path": "RUNTIME-INDEX.json",
    "identity_verification": "single_pinned_verifier_plus_recursive_git_tree_plus_protocol_bundle",
    "preferred_path": "pinned_runtime_package_verifier_plus_exact_commit_archive",
    "durable_fallback_path": "same_commit_github_prerelease_asset",
    "durable_release_tag_template": "digr-runtime-{SHA}",
    "durable_release_asset_template": "DIGR-RUNTIME-{SHA}.zip",
    "transient_fallback_path": "same_commit_github_actions_artifact",
    "runtime_index_schema": 2,
    "protocol_bundle_path": "bundle/EXECUTION_PROTOCOL.json",
    "attestation_scope": "commit+git_tree+manifest+VERSION+deterministic_helpers+execution_bundle+bundle_members"
  }
}
