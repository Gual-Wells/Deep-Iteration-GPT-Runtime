{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/incomplete-summary.schema.json",
  "title": "DIGR Berta2 incomplete delivery summary",
  "type": "object",
  "required": [
    "run_id", "phase", "unmet", "mechanical_minima_satisfied",
    "semantic_completion_assessed", "blocking_open_gaps", "delivery_ready"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 8},
    "phase": {"const": "INCOMPLETE"},
    "unmet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mechanical_minima_satisfied": {"type": "boolean"},
    "semantic_completion_assessed": {"type": "boolean"},
    "blocking_open_gaps": {"type": "integer", "minimum": 0},
    "delivery_ready": {"const": false}
  },
  "additionalProperties": false
}
