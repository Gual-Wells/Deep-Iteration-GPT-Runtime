{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/clock-journal-event.schema.json",
  "title": "DIGR 5.0 Clock Journal Event",
  "type": "object",
  "required": ["seq", "run_id", "event", "snapshot", "state", "prev_hash", "record_hash"],
  "properties": {
    "seq": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string", "minLength": 8},
    "event": {"type": "string", "minLength": 1},
    "snapshot": {"$ref": "clock-snapshot.schema.json"},
    "state": {"enum": ["MAIN", "SOURCE", "D_EXCLUSIVE", "V_EXCLUSIVE", "META", "IDLE", null]},
    "prev_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
