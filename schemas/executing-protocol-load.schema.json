{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/executing-protocol-load.schema.json",
  "title": "DIGR Executing Protocol Load Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "commit_sha",
    "manifest_sha256",
    "version",
    "protocol",
    "source_mode",
    "container_path",
    "container_sha256",
    "container_byte_length",
    "members",
    "manifest_bytes_base64"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "const": "5.0.0-Berta2"
    },
    "protocol": {
      "const": "digr-v5.0"
    },
    "source_mode": {
      "enum": [
        "bundle",
        "individual"
      ]
    },
    "container_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "container_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_byte_length": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "byte_length"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_bytes_base64": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false
}
