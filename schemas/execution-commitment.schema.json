{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/execution-commitment.schema.json",
  "title": "DIGR Alpha 6 Execution Commitment",
  "type": "object",
  "required": ["schema_version","component_path","component_blob_sha","operation","executor","direct_execution","rejects_substitution","rejects_manual_result","reeducation_round"],
  "properties": {
    "schema_version": {"const": 1},
    "component_path": {"type":"string","minLength":1},
    "component_blob_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "operation": {"type":"string","minLength":1},
    "executor": {"type":"string","minLength":1},
    "direct_execution": {"type":"boolean"},
    "rejects_substitution": {"type":"boolean"},
    "rejects_manual_result": {"type":"boolean"},
    "reeducation_round": {"type":"integer","minimum":0,"maximum":2}
  },
  "additionalProperties": false
}
