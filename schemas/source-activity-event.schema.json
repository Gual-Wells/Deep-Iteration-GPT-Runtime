{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/source-activity-event.schema.json",
  "title": "DIGR 5.0 Alpha 2 Source Activity Event",
  "type": "object",
  "required": [
    "seq",
    "clock_event_ref",
    "source_ids",
    "prev_hash",
    "record_hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "clock_event_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "prev_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
