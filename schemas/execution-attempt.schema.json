{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/execution-attempt.schema.json",
  "title": "DIGR Alpha 6 Execution Attempt Receipt",
  "type": "object",
  "required": ["schema_version","commitment_sha256","component_path","component_blob_sha","executor","status"],
  "properties": {
    "schema_version": {"const":1},
    "commitment_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "component_path": {"type":"string","minLength":1},
    "component_blob_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "executor": {"type":"string","minLength":1},
    "status": {"enum":["SUCCEEDED","FAILED"]},
    "failure_reason": {"type":["string","null"],"minLength":1}
  },
  "allOf": [
    {"if":{"properties":{"status":{"const":"FAILED"}}},"then":{"required":["failure_reason"]}},
    {"if":{"properties":{"status":{"const":"SUCCEEDED"}}},"then":{"properties":{"failure_reason":{"type":"null"}}}}
  ],
  "additionalProperties": false
}
