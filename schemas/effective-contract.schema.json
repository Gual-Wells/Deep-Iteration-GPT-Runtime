    },
    "S": {
      "type": "object",
      "required": [
        "n",
        "t_seconds",
        "r",
        "b"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "t_seconds": {
          "type": "number",
          "minimum": 0
        },
        "r": {
          "type": "integer",
          "minimum": 0
        },
        "b": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "D_s": {
      "type": "integer",
      "minimum": 0
    },
    "L_e": {
      "enum": [
        1,
        2,
        3
      ]
    }
