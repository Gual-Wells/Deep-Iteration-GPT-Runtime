{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/effective-contract.schema.json",
  "title": "DIGR 5.0 Alpha 2 Effective Contract",
  "type": "object",
  "required": [
    "N",
    "T_seconds",
    "R",
    "B",
    "S",
    "D_s",
    "L_e",
    "source_disposition",
    "source_waiver_reason",
    "L_mismatch_blocks_delivery"
  ],
  "properties": {
    "N": {
      "type": "integer",
      "minimum": 0
    },
    "T_seconds": {
      "type": "number",
      "minimum": 0
    },
    "R": {
      "type": "integer",
      "minimum": 0
    },
    "B": {
      "enum": [
        0,
        1
      ]
    },
    "S": {
      "type": "object",
      "required": [
        "n",
        "t_seconds",
        "r",
        "b"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "t_seconds": {
          "type": "number",
          "minimum": 0
        },
        "r": {
          "type": "integer",
          "minimum": 0
        },
        "b": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "D_s": {
      "type": "integer",
      "minimum": 0
    },
    "L_e": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "source_disposition": {
      "enum": [
        "REQUIRED",
        "WAIVED"
      ]
    },
    "source_waiver_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "L_mismatch_blocks_delivery": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
