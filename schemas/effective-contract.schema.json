{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/effective-contract.schema.json",
  "title": "DIGR 4.1 Effective Contract",
  "type": "object",
  "required": [
    "N",
    "T_seconds",
    "R",
    "B",
    "S",
