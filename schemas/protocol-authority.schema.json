{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/protocol-authority.schema.json",
  "title": "DIGR 5.0 Repository-Delegated Protocol Authority",
  "type": "object",
  "required": [
    "route",
    "P_run"
  ],
  "properties": {
    "route": {
      "$ref": "route-receipt.schema.json"
    },
    "P_run": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "repository_full_name",
        "commit_sha"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "5.0.0-Berta1"
        },
        "repository_full_name": {
          "const": "Gual-Wells/Deep-Iteration-GPT-Runtime"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
