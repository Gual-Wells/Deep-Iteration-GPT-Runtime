{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/clock-snapshot.schema.json",
  "title": "DIGR Clock Snapshot",
  "type": "object",
  "required": ["provider", "session_id", "boot_id", "monotonic_ns", "wall_ns"],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "boot_id": {"type": ["string", "null"], "minLength": 1},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "wall_ns": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
