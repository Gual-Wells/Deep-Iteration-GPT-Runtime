{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/run-summary.schema.json",
  "title": "DIGR 5.0.0-Berta2 Delivered Run Summary",
  "type": "object",
  "required": [
    "run_id",
    "authority",
    "invocation",
    "phase",
    "U0",
    "contract",
    "actuals",
    "provenance",
    "mechanical_checks",
    "mechanical_minima_satisfied",
    "semantic_completion_assessed",
    "structured_completion_ready",
    "audit_logs",
    "blocking_open_gaps",
    "clock_journal_events",
    "delivery_ready",
    "final"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "authority": {
      "$ref": "protocol-authority.schema.json"
    },
    "invocation": {
      "$ref": "invocation-surface.schema.json"
    },
    "U0": {
      "type": [
        "object",
        "null"
      ]
    },
    "contract": {
      "$ref": "effective-contract.schema.json"
    },
    "actuals": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "mechanical_minima_satisfied": {
      "type": "boolean"
    },
    "semantic_completion_assessed": {
      "type": "boolean"
    },
    "structured_completion_ready": {"type": "boolean"},
    "audit_logs": {
      "type": "object",
      "required": ["TOTAL", "N", "T", "R", "B", "S", "D", "V", "L"],
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "byte_length"],
        "properties": {
          "path": {"type": "string", "pattern": "^logs/(TOTAL|N|T|R|B|S|D|V|L)\\.ndjson$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "blocking_open_gaps": {
      "type": "integer",
      "minimum": 0
    },
    "clock_journal_events": {
      "type": "integer",
      "minimum": 2
    },
    "delivery_ready": {
      "const": true
    },
    "phase": {
      "const": "DELIVERED"
    },
    "mechanical_checks": {
      "type": "object"
    },
    "final": {
      "type": "object",
      "required": [
        "payload_sha256", "payload_byte_length", "media_type", "candidate_revision",
        "candidate_digest", "candidate_payload_path", "terminal_state_sha256", "preflight_receipt_path",
        "preflight_receipt_sha256", "capability_negotiation_path",
        "capability_negotiation_sha256"
      ],
      "properties": {
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_byte_length": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "candidate_revision": {"type": "integer", "minimum": 0},
        "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_payload_path": {"type": "string", "pattern": "^state/candidate-payloads/[0-9a-f]{64}\\.bin$"},
        "terminal_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preflight_receipt_path": {"const": "preflight-receipt.json"},
        "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_negotiation_path": {"const": "capability-negotiation.json"},
        "capability_negotiation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
