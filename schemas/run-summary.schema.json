{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/run-summary.schema.json",
  "title": "DIGR 5.0 Internal Run Summary",
  "type": "object",
  "required": [
    "run_id",
    "authority",
    "invocation",
    "phase",
    "U0",
    "contract",
    "actuals",
    "provenance",
    "mechanical_checks",
    "mechanical_minima_satisfied",
    "semantic_completion_assessed",
    "blocking_open_gaps",
    "clock_journal_events",
    "delivery_ready"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "authority": {
      "$ref": "protocol-authority.schema.json"
    },
    "invocation": {
      "$ref": "invocation-surface.schema.json"
    },
    "U0": {
      "type": [
        "object",
        "null"
      ]
    },
    "contract": {
      "$ref": "effective-contract.schema.json"
    },
    "actuals": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "mechanical_minima_satisfied": {
      "type": "boolean"
    },
    "semantic_completion_assessed": {
      "type": "boolean"
    },
    "blocking_open_gaps": {
      "type": "integer",
      "minimum": 0
    },
    "clock_journal_events": {
      "type": "integer",
      "minimum": 2
    },
    "delivery_ready": {
      "type": "boolean"
    },
    "phase": {
      "const": "FINISHED"
    },
    "mechanical_checks": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
