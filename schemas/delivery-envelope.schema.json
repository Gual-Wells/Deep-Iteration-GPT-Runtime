{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/delivery-envelope.schema.json",
  "title": "DIGR stable.1 exact delivery envelope",
  "type": "object",
  "required": [
    "schema_version", "run_id", "status", "payload_path",
    "payload_sha256", "payload_byte_length", "media_type",
    "candidate_revision", "candidate_digest", "candidate_payload_path",
    "preflight_receipt_path", "preflight_receipt_sha256",
    "capability_negotiation_path", "capability_negotiation_sha256", "run_summary_path",
    "run_summary_sha256", "stable_proof_path", "stable_proof_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 8},
    "status": {"const": "DELIVERED"},
    "payload_path": {"const": "final/delivery.bin"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_byte_length": {"type": "integer", "minimum": 1},
    "media_type": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 0},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_payload_path": {"type": "string", "pattern": "^state/candidate-payloads/[0-9a-f]{64}\\.bin$"},
    "preflight_receipt_path": {"const": "preflight-receipt.json"},
    "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_negotiation_path": {"const": "capability-negotiation.json"},
    "capability_negotiation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_summary_path": {"const": "final/run-summary.json"},
    "run_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_proof_path": {"const": "final/stable-proof.json"},
    "stable_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
