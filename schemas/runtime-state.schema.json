{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR v2.2 Runtime State",
  "type": "object",
  "required": [
    "protocol",
    "original_task",
    "stage",
    "status"
  ],
  "properties": {
    "protocol": {
      "const": "digr-v2.2"
    },
    "original_task": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "pre_execution_evolution",
        "native_execution",
        "result_reentry",
        "completed"
      ]
    },
    "status": {
      "enum": [
        "anchored",
        "routing",
        "prompt_iterating",
        "researching_method",
        "executing",
        "auditing",
        "redoing",
        "reporting",
        "completed"
      ]
    },
    "requested_min_iterations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "actual_prompt_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "complexity_budget": {
      "type": [
        "string",
        "null"
      ]
    },
    "complexity_level": {
      "enum": [
        "Focused",
        "Analytical",
        "Deep",
        "Research",
        "Extended Research",
        "Auto"
      ]
    },
    "redo_count": {
      "type": "integer",
      "minimum": 0
    },
    "native_capability_preserved": {
      "type": "boolean"
    },
    "active_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
