{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR 2.3 Runtime State",
  "type": "object",
  "properties": {
    "U0": {
      "type": "string"
    },
    "n_requested": {},
    "t_raw": {},
    "resolved_protocol_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_prompt_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "redo_count": {
      "type": "integer",
      "minimum": 0
    },
    "t_budget_adequacy": {
      "enum": [
        "pending",
        "matched",
        "early_convergence",
        "resource_limited",
        "not_applicable"
      ]
    }
  },
  "additionalProperties": true
}
