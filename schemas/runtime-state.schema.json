{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/runtime-state.schema.json",
  "title": "DIGR 4.1 Lightweight Runtime State",
  "type": "object",
  "required": [
    "task_startup",
    "U0",
    "contract",
    "main",
    "sources",
    "dictator",
    "time"
  ],
  "properties": {
    "U0": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "$ref": "effective-contract.schema.json"
    },
    "main": {
      "type": "object",
      "required": [
        "N_actual",
        "R_actual",
        "est_snapshot",
        "current_result_state"
      ],
      "properties": {
        "N_actual": {
          "type": "integer",
          "minimum": 0
        },
        "R_actual": {
          "type": "integer",
          "minimum": 0
        },
        "est_snapshot": {
          "type": [
            "string",
            "object",
            "array",
            "null"
          ]
        },
        "current_result_state": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "n_actual",
          "r_actual"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "n_actual": {
            "type": "integer",
            "minimum": 0
          },
          "r_actual": {
            "type": "integer",
            "minimum": 0
          },
          "est_snapshot": {
            "type": [
              "string",
              "object",
              "array",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "dictator": {
      "type": "object",
      "required": [
        "D_actual",
        "L_actual",
        "d_state_summary"
      ],
      "properties": {
        "D_actual": {
          "type": "integer",
          "minimum": 0
        },
        "L_actual": {
          "enum": [
            1,
            2,
            3,
            null
          ]
        },
        "d_state_summary": {
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": [
        "timing_ready",
        "formal_started",
        "foreground_state",
        "intervals",
        "T_actual_seconds",
        "t_actual_seconds",
        "finished",
        "T_actual_ns",
        "t_actual_ns",
        "T_hard_verified",
        "t_hard_verified"
      ],
      "properties": {
        "timing_ready": {
          "type": "boolean"
        },
        "formal_started": {
          "type": "boolean"
        },
        "finished": {
          "type": "boolean"
        },
        "foreground_state": {
          "enum": [
            "MAIN",
            "SOURCE",
            "D_EXCLUSIVE",
            "META",
            "IDLE",
            null
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state",
              "start",
              "end",
              "observed_ns",
              "hard_verified"
            ],
            "properties": {
              "state": {
                "enum": [
                  "MAIN",
                  "SOURCE",
                  "D_EXCLUSIVE",
                  "META",
                  "IDLE"
                ]
              },
              "start": {
                "type": "object",
                "required": [
                  "provider",
                  "session_id",
                  "boot_id",
                  "monotonic_ns",
                  "wall_ns"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "boot_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "monotonic_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "wall_ns": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "end": {
                "type": "object",
                "required": [
                  "provider",
                  "session_id",
                  "boot_id",
                  "monotonic_ns",
                  "wall_ns"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "boot_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "monotonic_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "wall_ns": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "observed_ns": {
                "type": "integer",
                "minimum": 0
              },
              "hard_verified": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "T_actual_seconds": {
          "type": "number",
          "minimum": 0
        },
        "t_actual_seconds": {
          "type": "number",
          "minimum": 0
        },
        "T_actual_ns": {
          "type": "integer",
          "minimum": 0
        },
        "t_actual_ns": {
          "type": "integer",
          "minimum": 0
        },
        "T_hard_verified": {
          "type": "boolean"
        },
        "t_hard_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "task_startup": {
      "$ref": "task-startup.schema.json"
    }
  },
  "additionalProperties": false
}
