{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR 3.0 Lightweight Runtime State",
  "type": "object",
  "required": [
    "U0",
    "main",
    "sources"
  ],
  "properties": {
    "U0": {
      "type": "string"
    },
    "clock": {
      "type": [
        "object",
        "null"
      ]
    },
    "main": {
      "type": "object",
      "properties": {
        "N_requested": {
          "type": [
            "integer",
            "null"
          ]
        },
        "N_actual": {
          "type": "integer",
          "minimum": 0
        },
        "R_requested": {
          "type": [
            "integer",
            "null"
          ]
        },
        "R_actual": {
          "type": "integer",
          "minimum": 0
        },
        "est_snapshot": {
          "type": [
            "string",
            "object",
            "array",
            "null"
          ]
        },
        "current_result_state": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "N_actual",
        "R_actual"
      ],
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aggregate_source_intervals": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
