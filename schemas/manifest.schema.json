{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR Manifest 2.3",
  "type": "object",
  "required": [
    "name",
    "version",
    "protocol",
    "trigger",
    "complexity_reference",
    "global_invariants",
    "core_sequence",
    "policies"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "const": "2.3.0"
    },
    "protocol": {
      "const": "digr-v2.3"
    },
    "trigger": {
      "type": "object"
    },
    "complexity_reference": {
      "type": "object"
    },
    "global_invariants": {
      "type": "array"
    },
    "core_sequence": {
      "type": "array"
    },
    "policies": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
