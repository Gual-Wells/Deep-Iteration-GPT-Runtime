{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR 3.0 Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "protocol",
    "trigger",
    "parameters",
    "core",
    "policies"
  ],
  "properties": {
    "version": {
      "const": "3.0.0"
    },
    "protocol": {
      "const": "digr-v3.0"
    },
    "trigger": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "core": {
      "type": "array",
      "minItems": 1
    },
    "policies": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
