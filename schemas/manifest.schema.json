{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/manifest.schema.json",
  "title": "DIGR 5.0.0 Berta2 Navigation Manifest",
  "type": "object",
  "required": [
    "runtime_descriptor",
    "navigation_authority",
    "protocol",
    "version",
    "bootstrap_entry",
    "startup_slice",
    "model_protocol_source",
    "entrypoint",
    "help",
    "core",
    "execution_bundle",
    "deterministic_helpers",
    "interfaces",
    "workspace_spec",
    "schemas"
  ],
  "properties": {
    "runtime_descriptor": {"const": "runtime-descriptor.json"},
    "navigation_authority": {"const": true},
    "protocol": {"const": "digr-v5.0"},
    "version": {"const": "5.0.0-Berta2"},
    "bootstrap_entry": {"const": "entry/STARTUP.md"},
    "startup_slice": {
      "const": ["entry/STARTUP.md"]
    },
    "model_protocol_source": {"const": "entry/MODEL_PROTOCOL_SOURCE.md"},
    "entrypoint": {"const": "entry/DEEP_ITERATION_ENTRY.md"},
    "help": {"const": "entry/HELP.md"},
    "core": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "execution_bundle": {
      "type": "object",
      "required": ["path", "schema", "members"],
      "properties": {
        "path": {"const": "dist/EXECUTION_PROTOCOL.json"},
        "schema": {"const": 1},
        "members": {
          "const": [
            "entry/DEEP_ITERATION_ENTRY.md",
            "core/00_RESULT_SOVEREIGNTY.md",
            "core/05_TASK_COMMITMENT.md",
            "core/10_INVOCATION_AND_U0.md",
            "core/11_PARAMETER_FORMAT_AND_RESOLUTION.md",
            "core/12_PROTOCOL_AUTHORITY_AND_SELF_HOSTING.md",
            "core/15_SEMANTIC_DEFAULT_COMPLETION.md",
            "core/20_EFFECTIVE_CONTRACT.md",
            "core/25_RUN_SESSION_AND_EXTERNAL_MEMORY.md",
            "core/30_EVOLUTION_STATE_MEMORY.md",
            "core/35_STRATEGY_AND_CANDIDATE_STATE.md",
            "core/40_NATIVE_EVOLUTION.md",
            "core/50_SOURCE_EVOLUTION.md",
            "core/60_FORMAL_ACTIVE_TIME.md",
            "core/70_REENTRY_AND_ABG.md",
            "core/75_DISRUPTIVE_GAMBIT.md",
            "core/76_PERSISTENT_VIEWPOINT.md",
            "core/77_ISOLATION_LEVELS.md",
            "core/80_STOP_AND_PROOF.md",
            "core/85_AUDIT_LOGS.md"
          ]
        }
      },
      "additionalProperties": false
    },
    "deterministic_helpers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "interfaces": {
      "type": "object",
      "required": ["routing", "repository_transport", "invocation_surface", "parameter_resolution", "run_session", "workspace", "clock_journal", "event_receipt", "execution_bundle", "execution_protocol_load", "capabilities", "host_adapter", "delivery"],
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "workspace_spec": {"const": "workspace/layout-v2.json"},
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._-]+\\.schema\\.json$"}
    }
  },
  "additionalProperties": false
}
