{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR Manifest 2.2",
  "type": "object",
  "required": [
    "name",
    "version",
    "protocol",
    "trigger",
    "entrypoint",
    "global_invariants",
    "core_sequence",
    "policies"
  ],
  "properties": {
    "version": {
      "const": "2.2.0"
    },
    "protocol": {
      "const": "digr-v2.2"
    },
    "trigger": {
      "type": "object"
    },
    "entrypoint": {
      "type": "string"
    },
    "global_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
