{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/manifest.schema.json",
  "title": "DIGR 4.1 Manifest",
  "type": "object",
  "required": ["name","short_name","version","protocol","language","philosophy","trigger","defaults","parameters","time_states","core","bootstrap_entry","entrypoint","help","deterministic_helpers","policies","routing_schema"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "short_name": {"const": "DIGR"},
    "version": {"const": "4.1.0"},
    "protocol": {"const": "digr-v4.1"},
    "language": {"type": "string"},
    "routing_schema": {"const": 1},
    "bootstrap_entry": {"const": "bootstrap/BOOTSTRAP.md"},
    "philosophy": {"type": "object"},
    "trigger": {"type": "object"},
    "defaults": {
      "type": "object",
      "required": ["B","b","L_e","semantic_completion"],
      "properties": {
        "B": {"const": 0}, "b": {"const": 0}, "L_e": {"const": 1},
        "semantic_completion": {"const": ["N","T","R","n","t","r","s"]}
      }, "additionalProperties": false
    },
    "parameters": {"type": "object"},
    "time_states": {"type": "object"},
    "core": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "entrypoint": {"const": "entry/DEEP_ITERATION_ENTRY.md"},
    "help": {"const": "entry/HELP.md"},
    "deterministic_helpers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policies": {"type": "object"}
  },
  "additionalProperties": false
}
