{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/manifest.schema.json",
  "title": "DIGR 5.0.0 Alpha 9 Manifest",
  "type": "object",
  "required": [
    "name",
    "short_name",
    "version",
    "protocol",
    "language",
    "philosophy",
    "trigger",
    "defaults",
    "parameters",
    "time_states",
    "core",
    "bootstrap_entry",
    "bootstrap_index",
    "startup_slice",
    "entrypoint",
    "help",
    "deterministic_helpers",
    "policies",
    "routing_schema",
    "repository_transport_schema",
    "invocation_surface_schema",
    "parameter_resolution_schema",
    "routing",
    "run_session_schema",
    "workspace_schema",
    "clock_journal_schema",
    "event_receipt_schema",
    "release",
    "workspace_spec",
    "execution_bundle_schema",
    "execution_protocol_load_schema",
    "execution_bundle",
    "execution_commitment_schema",
    "execution_attempt_schema",
    "runtime_distribution_schema",
    "runtime_distribution"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "const": "DIGR"
    },
    "version": {
      "const": "5.0.0-alpha.10"
    },
    "protocol": {
      "const": "digr-v5.0"
    },
    "language": {
      "type": "string"
    },
    "routing_schema": {
      "const": 4
    },
    "invocation_surface_schema": {
      "const": 2
    },
    "parameter_resolution_schema": {
      "const": 2
    },
    "run_session_schema": {
      "const": 7
    },
    "workspace_schema": {
      "const": 2
    },
    "clock_journal_schema": {
      "const": 1
    },
    "event_receipt_schema": {
      "const": 2
    },
    "bootstrap_entry": {
      "const": "bootstrap/BOOTSTRAP.md"
    },
    "startup_slice": {
      "const": [
        "bootstrap/INDEX.md",
        "bootstrap/BOOTSTRAP.md",
        "entry/STARTUP.md"
      ]
    },
    "entrypoint": {
      "const": "entry/DEEP_ITERATION_ENTRY.md"
    },
    "help": {
      "const": "entry/HELP.md"
    },
    "core": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deterministic_helpers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace_spec": {
      "const": "workspace/layout-v2.json"
    },
    "philosophy": {
      "type": "object"
    },
    "trigger": {
      "type": "object"
    },
    "defaults": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "time_states": {
      "type": "object"
    },
    "policies": {
      "type": "object"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_route_keys",
        "candidate_match",
        "repository_full_name",
        "repository_url",
        "requested_ref",
        "ref_api_url",
        "branch_api_url",
        "manifest_path",
        "version_path",
        "content_api_template",
        "pinned_raw_template",
        "content_raw_media_type",
        "mutable_ref_policy"
      ],
      "properties": {
        "candidate_route_keys": {
          "const": [
            "DIGR",
            "深度迭代"
          ]
        },
        "candidate_match": {
          "const": "lstrip_prefix; DIGR_exact_uppercase; remainder_unvalidated"
        },
        "repository_full_name": {
          "const": "Gual-Wells/Deep-Iteration-GPT-Runtime"
        },
        "repository_url": {
          "const": "https://github.com/Gual-Wells/Deep-Iteration-GPT-Runtime"
        },
        "requested_ref": {
          "const": "stable"
        },
        "ref_api_url": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/git/ref/heads/stable"
        },
        "branch_api_url": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/branches/stable"
        },
        "manifest_path": {
          "const": "manifest.json"
        },
        "version_path": {
          "const": "VERSION"
        },
        "content_api_template": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/contents/{PATH}?ref={SHA}"
        },
        "pinned_raw_template": {
          "const": "https://raw.githubusercontent.com/Gual-Wells/Deep-Iteration-GPT-Runtime/{SHA}/{PATH}"
        },
        "content_raw_media_type": {
          "const": "application/vnd.github.raw+json"
        },
        "mutable_ref_policy": {
          "const": "connector_branch_head_or_direct_rest_branch_ref_consensus; search_index_forbidden; attempt_required_before_failure"
        }
      }
    },
    "release": {
      "type": "object"
    },
    "repository_transport_schema": {
      "const": 3
    },
    "execution_bundle_schema": {
      "const": 1
    },
    "execution_protocol_load_schema": {
      "const": 1
    },
    "execution_bundle": {
      "type": "object",
      "required": [
        "path",
        "schema",
        "members"
      ],
      "properties": {
        "path": {
          "const": "bundle/EXECUTION_PROTOCOL.json"
        },
        "schema": {
          "const": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "bootstrap_index": {
      "const": "bootstrap/INDEX.md"
    },
    "execution_commitment_schema": {
      "const": 1
    },
    "execution_attempt_schema": {
      "const": 1
    },
    "runtime_distribution_schema": {
      "const": 3
    },
    "runtime_distribution": {
      "type": "object",
      "required": [
        "schema",
        "mode",
        "workflow_path",
        "artifact_name_template",
        "archive_filename_template",
        "member_source",
        "runtime_index_path",
        "identity_verification",
        "preferred_path",
        "durable_fallback_path",
        "durable_release_tag_template",
        "durable_release_asset_template",
        "transient_fallback_path",
        "runtime_index_schema",
        "protocol_bundle_path",
        "attestation_scope"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "mode": {
          "const": "native_bridge_or_exact_commit_release_or_actions_artifact"
        },
        "workflow_path": {
          "const": ".github/workflows/digr-runtime-artifact.yml"
        },
        "artifact_name_template": {
          "const": "digr-runtime-{SHA}"
        },
        "archive_filename_template": {
          "const": "DIGR-RUNTIME-{SHA}.zip"
        },
        "member_source": {
          "const": "deterministic_helpers_plus_execution_bundle"
        },
        "runtime_index_path": {
          "const": "RUNTIME-INDEX.json"
        },
        "identity_verification": {
          "const": "single_pinned_verifier_plus_recursive_git_tree_plus_protocol_bundle"
        },
        "preferred_path": {
          "const": "pinned_runtime_package_verifier_plus_exact_commit_archive"
        },
        "durable_fallback_path": {
          "const": "same_commit_github_prerelease_asset"
        },
        "durable_release_tag_template": {
          "const": "digr-runtime-{SHA}"
        },
        "durable_release_asset_template": {
          "const": "DIGR-RUNTIME-{SHA}.zip"
        },
        "transient_fallback_path": {
          "const": "same_commit_github_actions_artifact"
        },
        "runtime_index_schema": {
          "const": 2
        },
        "protocol_bundle_path": {
          "const": "bundle/EXECUTION_PROTOCOL.json"
        },
        "attestation_scope": {
          "const": "commit+git_tree+manifest+VERSION+deterministic_helpers+execution_bundle+bundle_members"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
