{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/manifest.schema.json",
  "title": "DIGR 5.0.0 Alpha 3 Manifest",
  "type": "object",
  "required": [
    "name",
    "short_name",
    "version",
    "protocol",
    "language",
    "philosophy",
    "trigger",
    "defaults",
    "parameters",
    "time_states",
    "core",
    "bootstrap_entry",
    "startup_slice",
    "entrypoint",
    "help",
    "deterministic_helpers",
    "policies",
    "routing_schema",
    "repository_transport_schema",
    "invocation_surface_schema",
    "parameter_resolution_schema",
    "routing",
    "run_session_schema",
    "workspace_schema",
    "clock_journal_schema",
    "event_receipt_schema",
    "release",
    "workspace_spec"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "const": "DIGR"
    },
    "version": {
      "const": "5.0.0-alpha.3"
    },
    "protocol": {
      "const": "digr-v5.0"
    },
    "language": {
      "type": "string"
    },
    "routing_schema": {
      "const": 3
    },
    "invocation_surface_schema": {
      "const": 2
    },
    "parameter_resolution_schema": {
      "const": 1
    },
    "run_session_schema": {
      "const": 2
    },
    "workspace_schema": {
      "const": 2
    },
    "clock_journal_schema": {
      "const": 1
    },
    "event_receipt_schema": {
      "const": 2
    },
    "bootstrap_entry": {
      "const": "bootstrap/BOOTSTRAP.md"
    },
    "startup_slice": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entrypoint": {
      "const": "entry/DEEP_ITERATION_ENTRY.md"
    },
    "help": {
      "const": "entry/HELP.md"
    },
    "core": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deterministic_helpers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace_spec": {
      "const": "workspace/layout-v2.json"
    },
    "philosophy": {
      "type": "object"
    },
    "trigger": {
      "type": "object"
    },
    "defaults": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "time_states": {
      "type": "object"
    },
    "policies": {
      "type": "object"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_route_keys",
        "candidate_match",
        "repository_full_name",
        "repository_url",
        "requested_ref",
        "ref_api_url",
        "branch_api_url",
        "manifest_path",
        "version_path",
        "content_api_template",
        "pinned_raw_template",
        "content_raw_media_type",
        "mutable_ref_policy"
      ],
      "properties": {
        "candidate_route_keys": {
          "const": [
            "DIGR",
            "深度迭代"
          ]
        },
        "candidate_match": {
          "const": "lstrip_prefix; DIGR_exact_uppercase; remainder_unvalidated"
        },
        "repository_full_name": {
          "const": "Gual-Wells/Deep-Iteration-GPT-Runtime"
        },
        "repository_url": {
          "const": "https://github.com/Gual-Wells/Deep-Iteration-GPT-Runtime"
        },
        "requested_ref": {
          "const": "stable"
        },
        "ref_api_url": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/git/ref/heads/stable"
        },
        "branch_api_url": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/branches/stable"
        },
        "manifest_path": {
          "const": "manifest.json"
        },
        "version_path": {
          "const": "VERSION"
        },
        "content_api_template": {
          "const": "https://api.github.com/repos/Gual-Wells/Deep-Iteration-GPT-Runtime/contents/{PATH}?ref={SHA}"
        },
        "pinned_raw_template": {
          "const": "https://raw.githubusercontent.com/Gual-Wells/Deep-Iteration-GPT-Runtime/{SHA}/{PATH}"
        },
        "content_raw_media_type": {
          "const": "application/vnd.github.raw+json"
        },
        "mutable_ref_policy": {
          "const": "direct_live_ref_plus_branch_consensus; search_index_forbidden; attempt_required_before_failure"
        }
      }
    },
    "release": {
      "type": "object"
    },
    "repository_transport_schema": {
      "const": 1
    }
  },
  "additionalProperties": true
}
