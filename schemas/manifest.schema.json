{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR v2 Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "protocol",
    "trigger",
    "entrypoint",
    "global_invariants",
    "core_sequence",
    "objectives",
    "stages"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "protocol": {
      "const": "digr-v2"
    },
    "trigger": {
      "type": "object"
    },
    "entrypoint": {
      "type": "string"
    },
    "global_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "object"
    },
    "stages": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
