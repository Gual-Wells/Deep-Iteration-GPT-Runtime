{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR v2.1 Execution Evidence",
  "type": "object",
  "required": [
    "protocol",
    "external_verifiable",
    "runtime_attested",
    "unverified_or_degraded",
    "evidence_status"
  ],
  "properties": {
    "protocol": {
      "const": "digr-v2"
    },
    "external_verifiable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "rule_fetch",
              "web_search",
              "file_read",
              "tool_call",
              "code_execution",
              "generated_artifact",
              "test_result",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_attested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_or_degraded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_status": {
      "enum": [
        "complete",
        "partial",
        "degraded",
        "failed"
      ]
    },
    "summary_lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "additionalProperties": false
}
