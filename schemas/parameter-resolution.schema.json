{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/parameter-resolution.schema.json",
  "title": "DIGR 5.0 Stable Parameter Resolution",
  "type": "object",
  "required": [
    "status",
    "N",
    "T_seconds",
    "R",
    "B",
    "S",
    "D_s",
    "V_o",
    "L_e",
    "normalized_surface",
    "diagnostics",
    "source_policy"
  ],
  "properties": {
    "status": {
      "enum": [
        "RESOLVED",
        "AMBIGUOUS",
        "INVALID"
      ]
    },
    "N": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "T_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "R": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "B": {
      "enum": [
        0,
        1
      ]
    },
    "S": {
      "type": "object",
      "required": [
        "n",
        "t_seconds",
        "r",
        "b"
      ],
      "properties": {
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "t_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "r": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "b": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "D_s": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "V_o": {
      "type": "integer",
      "minimum": 0
    },
    "L_e": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "normalized_surface": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_policy": {
      "enum": ["auto", "required", "off"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "RESOLVED"}}},
      "then": {
        "properties": {
          "N": {"type": "integer", "minimum": 0},
          "T_seconds": {"type": "number", "minimum": 0},
          "R": {"type": "integer", "minimum": 0},
          "D_s": {"type": "integer", "minimum": 0},
          "V_o": {"type": "integer", "minimum": 0},
          "S": {
            "properties": {
              "n": {"type": "integer", "minimum": 0},
              "t_seconds": {"type": "number", "minimum": 0},
              "r": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "RESOLVED"}, "B": {"const": 1}}, "required": ["status", "B"]},
      "then": {"properties": {"T_seconds": {"type": "number", "exclusiveMinimum": 0}}}
    },
    {
      "if": {
        "properties": {
          "status": {"const": "RESOLVED"},
          "S": {"properties": {"b": {"const": 1}}, "required": ["b"]}
        },
        "required": ["status", "S"]
      },
      "then": {"properties": {"S": {"properties": {"t_seconds": {"type": "number", "exclusiveMinimum": 0}}}}}
    }
  ],
  "additionalProperties": false
}
