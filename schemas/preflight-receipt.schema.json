{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/preflight-receipt.schema.json",
  "title": "DIGR 5.0 Berta2 Pinned Structural Preflight Receipt",
  "type": "object",
  "required": ["schema_version", "status", "raw_message_sha256", "kind", "alias", "task_raw", "parameter_surface", "profile", "source_policy", "corrections", "warnings", "startup_acquisition_performed", "additional_artifact_fetch_required", "repository_binding", "native_message"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["READY", "NEEDS_COMPLETION", "NATIVE", "HELP", "INVALID", "NEEDS_CORRECTION", "ADVISORY", "UNSUPPORTED"]},
    "raw_message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["EXECUTING", "HELP", "NATIVE", "INVALID"]},
    "alias": {"enum": ["DIGR", "深度迭代"]},
    "task_raw": {"type": ["string", "null"]},
    "parameter_surface": {"type": ["string", "null"]},
    "profile": {"enum": ["adaptive", "standard", "berta2", "legacy-alpha4", "invalid", null]},
    "source_policy": {"enum": ["auto", "required", "off", null]},
    "corrections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "startup_acquisition_performed": {"const": true},
    "additional_artifact_fetch_required": {"type": "boolean"},
    "native_message": {"type": ["string", "null"]},
    "repository_binding": {
      "type": "object",
      "required": ["schema_version", "route", "startup_files", "attempts"],
      "properties": {
        "schema_version": {"const": 1},
        "route": {
          "type": "object",
          "required": ["repository_full_name", "requested_ref", "pinned_commit", "manifest_path", "manifest_sha256", "version_path", "version_sha256"],
          "properties": {
            "repository_full_name": {"const": "Gual-Wells/Deep-Iteration-GPT-Runtime"},
            "requested_ref": {"const": "stable"},
            "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "manifest_path": {"const": "manifest.json"},
            "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "version_path": {"const": "VERSION"},
            "version_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "startup_files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["path", "sha256", "byte_length"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "byte_length": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "attempts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["seq", "purpose", "request_url", "source_kind", "freshness", "status", "success", "response_sha256", "commit_sha", "failure"],
            "properties": {
              "seq": {"type": "integer", "minimum": 1},
              "purpose": {"type": "string", "minLength": 1},
              "request_url": {"type": "string", "pattern": "^https://"},
              "source_kind": {"type": "string", "minLength": 1},
              "freshness": {"enum": ["live_direct", "immutable_sha", "untrusted"]},
              "status": {"type": "integer", "minimum": 0},
              "success": {"type": "boolean"},
              "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
              "failure": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["READY", "NEEDS_COMPLETION"]}}}, "then": {"properties": {"additional_artifact_fetch_required": {"const": true}, "kind": {"const": "EXECUTING"}}}},
    {"if": {"properties": {"status": {"const": "HELP"}}}, "then": {"properties": {"additional_artifact_fetch_required": {"const": true}, "kind": {"const": "HELP"}}}},
    {"if": {"properties": {"status": {"enum": ["NATIVE", "INVALID", "NEEDS_CORRECTION", "ADVISORY", "UNSUPPORTED"]}}}, "then": {"properties": {"additional_artifact_fetch_required": {"const": false}}}},
    {"if": {"properties": {"status": {"const": "NATIVE"}}}, "then": {"properties": {"native_message": {"type": "string"}}}},
    {"if": {"properties": {"status": {"enum": ["READY", "NEEDS_COMPLETION", "HELP", "INVALID", "NEEDS_CORRECTION", "ADVISORY", "UNSUPPORTED"]}}}, "then": {"properties": {"native_message": {"const": null}}}}
  ],
  "additionalProperties": false
}
