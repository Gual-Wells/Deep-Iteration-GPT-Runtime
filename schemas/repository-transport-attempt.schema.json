{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/repository-transport-attempt.schema.json",
  "title": "DIGR 5.0.0-Berta2 Repository Transport Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "purpose", "request_url", "source_kind", "freshness", "status", "success"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "request_url": {"type": "string", "pattern": "^https://"},
    "source_kind": {"type": "string", "minLength": 1},
    "freshness": {"enum": ["live_direct", "immutable_sha", "untrusted"]},
    "status": {"type": "integer", "minimum": 0},
    "success": {"type": "boolean"},
    "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "failure": {"type": ["string", "null"], "minLength": 1}
  }
}
