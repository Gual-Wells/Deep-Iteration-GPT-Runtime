{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/completion-state.schema.json",
  "title": "DIGR 5.0 Alpha 4 Completion State",
  "type": "object",
  "required": [
    "gaps",
    "assessment_revisions"
  ],
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "completion-gap.schema.json"
      }
    },
    "assessment_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
