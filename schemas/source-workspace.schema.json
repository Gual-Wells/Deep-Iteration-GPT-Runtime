{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/source-workspace.schema.json",
  "title": "DIGR 5.0 Alpha 3 Source Workspace State",
  "type": "object",
  "required": [
    "source_id",
    "revision",
    "objective",
    "current_direction",
    "status",
    "finding_summary",
    "contradictions",
    "evidence_refs",
    "pivot_reason"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "current_direction": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "finding_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pivot_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
