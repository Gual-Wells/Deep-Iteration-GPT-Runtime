{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/est-snapshot.schema.json",
  "title": "DIGR 5.0 Alpha 4 EST Snapshot",
  "type": "object",
  "required": [
    "scope",
    "revision",
    "currently_supported_facts",
    "current_decisions",
    "superseded_assumptions",
    "open_questions",
    "active_routes",
    "dormant_reopenable_routes",
    "last_meaningful_changes",
    "strategy_revision",
    "candidate_revision"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "currently_supported_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "superseded_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_routes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dormant_reopenable_routes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_meaningful_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strategy_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "candidate_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
