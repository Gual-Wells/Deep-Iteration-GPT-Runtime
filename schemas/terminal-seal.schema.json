{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/terminal-seal.schema.json",
  "title": "DIGR Berta2 terminal mutation seal",
  "type": "object",
  "required": ["schema_version", "run_id", "phase", "binding_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 8},
    "phase": {"enum": ["DELIVERED", "INCOMPLETE", "ABORTED"]},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
