{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/exclusive-activity.schema.json",
  "title": "DIGR Berta1 D/V exclusive activity binding",
  "type": "object",
  "required": ["schema_version", "seq", "kind", "clock_event_ref", "component_ids", "prev_hash", "record_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "seq": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["D", "V"]},
    "clock_event_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
    "prev_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
