{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/viewpoint-ledger.schema.json",
  "title": "DIGR Berta1 private VLedger state",
  "type": "object",
  "required": ["schema_version", "viewpoint_id", "premise", "events", "status", "result", "result_digest", "semantic_distance", "nonredundant", "revision"],
  "properties": {
    "schema_version": {"const": 1},
    "viewpoint_id": {"type": "string", "minLength": 1},
    "premise": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["OPEN", "QUALIFIED", "DISCARDED"]},
    "result": {"type": ["string", "null"]},
    "result_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "semantic_distance": {"type": ["string", "null"]},
    "nonredundant": {"type": "boolean"},
    "revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
