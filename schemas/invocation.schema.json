{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR 2.3 Invocation",
  "type": "object",
  "required": [
    "enabled",
    "task_raw",
    "parameterized"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "task_raw": {
      "type": "string"
    },
    "min_prompt_iterations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "complexity_budget_raw": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque T expression preserved for ChatGPT semantic interpretation; schema does not convert it to minutes, tiers, tokens or workload."
    },
    "parameterized": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
