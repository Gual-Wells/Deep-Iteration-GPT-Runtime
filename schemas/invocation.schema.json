{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/invocation.schema.json",
  "title": "DIGR 4.1 Semantic Invocation State",
  "description": "Host-LLM semantic interpretation; not a parser grammar. Protocol authority is resolved separately.",
  "type": "object",
  "required": [
    "enabled",
    "kind",
    "task_raw",
    "explicit"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "off",
        "task",
        "help"
      ]
    },
    "alias": {
      "enum": [
        "DIGR",
        "深度迭代",
        null
      ]
    },
    "task_raw": {
      "type": "string"
    },
    "explicit": {
      "type": "object",
      "properties": {
        "N": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "T_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "R": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "B": {
          "enum": [
            0,
            1,
            null
          ]
        },
        "S": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "n": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "t_raw": {
              "type": [
                "string",
                "null"
              ]
            },
            "r": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "b": {
              "enum": [
                0,
                1,
                null
              ]
            }
          },
          "additionalProperties": false
        },
        "D_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "L_e": {
          "enum": [
            1,
            2,
            3,
            null
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true
          },
          "task_raw": {
            "minLength": 1
          },
          "alias": {
            "enum": [
              "DIGR",
              "深度迭代"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "off",
              "help"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "task_raw": {
            "maxLength": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
