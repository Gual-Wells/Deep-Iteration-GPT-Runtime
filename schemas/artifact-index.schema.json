{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/artifact-index.schema.json",
  "title": "DIGR 5.0 Alpha 2 Artifact Index",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "revision",
          "last_event_ref"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "last_event_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
