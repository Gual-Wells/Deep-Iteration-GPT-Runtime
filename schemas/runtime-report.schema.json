{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIGR 2.3 Runtime Report",
  "type": "object",
  "required": [
    "parameters",
    "prompt_iterations",
    "final_prompt",
    "evolution_metrics",
    "redo_count",
    "workflow_chain",
    "sources"
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "n_requested": {},
        "t_requested_raw": {},
        "t_reference_model": {
          "const": "GPT-5.6 Sol"
        },
        "t_reference_reasoning": {
          "const": "high"
        },
        "t_budget_adequacy": {
          "enum": [
            "matched",
            "early_convergence",
            "resource_limited",
            "not_applicable"
          ]
        },
        "t_adequacy_reason": {
          "type": "string"
        }
      },
      "required": [
        "t_reference_model",
        "t_reference_reasoning",
        "t_budget_adequacy"
      ],
      "additionalProperties": true
    },
    "prompt_iterations": {
      "type": "object"
    },
    "final_prompt": {
      "type": "string"
    },
    "evolution_metrics": {
      "type": "object"
    },
    "redo_count": {
      "type": "integer",
      "minimum": 0
    },
    "redo_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array"
    },
    "resolved_protocol": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
