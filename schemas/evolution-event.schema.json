{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gual-wells.github.io/Deep-Iteration-GPT-Runtime/schemas/evolution-event.schema.json",
  "title": "DIGR 5.0 Alpha 3 Semantic Event Receipt v2",
  "type": "object",
  "required": [
    "seq",
    "event_id",
    "kind",
    "scope",
    "summary",
    "action",
    "result",
    "evidence_refs",
    "clock_event_ref",
    "strategy_revision",
    "candidate_revision",
    "candidate_after_revision",
    "source_id",
    "source_revision",
    "source_after_revision",
    "retained",
    "prev_hash",
    "record_hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "pattern": "^E[0-9]{6}$"
    },
    "kind": {
      "enum": [
        "MAIN_EVOLUTION",
        "MAIN_REENTRY",
        "SOURCE_EVOLUTION",
        "SOURCE_REENTRY"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clock_event_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "candidate_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "candidate_after_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retained": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "prev_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_after_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
